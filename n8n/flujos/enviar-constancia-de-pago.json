    {
      "parameters": {
        "errorMessage": "El cliente no tiene correo registrado"
      },
      "id": "a77ec3b2-2582-5a8d-82ea-49aea3bef18b",
      "name": "Sin correo",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1320,
        560
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];\nconst bs = (n) => 'Bs ' + Number(n).toFixed(2).replace('.', ',').replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst fecha = (iso) => String(iso).slice(0, 10).split('-').reverse().join('/');\nconst periodoTexto = (p) => { const [anio, mes] = String(p).split('-'); return `${MESES[Number(mes) - 1]} ${anio}`; };\nconst esc = (t) => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst nombreDe = (u) => [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;\n\nconst cobro = $('Leer cobro').item.json;\nconst obra = $('Leer obra').item.json;\nconst cliente = $('Leer cliente').item.json;\nconst comprobante = cobro.comprobante ? `, comprobante ${esc(cobro.comprobante)}` : '';\nreturn {\n  json: {\n    correo: cliente.email,\n    asunto: `Constancia de pago ${cobro.numero} · ${obra.nombre}`,\n    html: `<p>Registramos el pago del cobro ${esc(cobro.numero)} de la obra ${esc(obra.nombre)} por ${bs(cobro.montoNeto)}, pagado el ${fecha(cobro.pagadoEn)}${comprobante}. Gracias.</p>`,\n  },\n};\n"
      },
      "id": "8ec85c05-3361-500e-afcf-172cd01d47c7",
      "name": "Armar constancia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.EMPRESA_NOMBRE }} <{{ $env.COBRANZA_REMITENTE }}>",
        "toEmail": "={{ $json.correo }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}<p>{{ $env.EMPRESA_NOMBRE }}</p>",
        "options": {
          "appendAttribution": false,
          "bccEmail": "={{ $env.COBRANZA_CORREO }}"
        }
      },
      "id": "25a79fc4-0e52-5705-a161-fb116c742118",
      "name": "Enviar constancia",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1540,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "cred201Mailpit01",
          "name": "SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FINANZAS_URL }}/cobros/{{ $('Leer cobro').item.json.id }}/envios",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo: 'CONSTANCIA_PAGO', destinatario: $('Armar constancia').item.json.correo, ejecucionN8n: $execution.id }) }}",
        "options": {
          "timeout": 10000
        }
