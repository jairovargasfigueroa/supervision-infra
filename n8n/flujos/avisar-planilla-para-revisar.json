        "jsCode": "// Anota el id del sobre como enviado (los últimos 500) para descartar el mismo aviso si vuelve a llegar\nconst datos = $getWorkflowStaticData('global');\nconst id = $('Planilla presentada').first().json.id;\ndatos.avisos = [...(datos.avisos ?? []).filter((visto) => visto !== id), id].slice(-500);\nreturn [{ json: { id, anotado: true, avisosGuardados: datos.avisos.length } }];\n"
      },
