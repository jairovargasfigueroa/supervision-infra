      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1760,
        560
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];\nconst bs = (n) => 'Bs ' + Number(n).toFixed(2).replace('.', ',').replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst fecha = (iso) => String(iso).slice(0, 10).split('-').reverse().join('/');\nconst periodoTexto = (p) => { const [anio, mes] = String(p).split('-'); return `${MESES[Number(mes) - 1]} ${anio}`; };\nconst esc = (t) => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst nombreDe = (u) => [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;\n\nconst { reenvio } = $('Planilla presentada').first().json.datos;\nconst planilla = $('Leer planilla').first().json;\nconst obra = $('Leer obra').first().json;\nconst cliente = $('Leer cliente').first().json;\nconst periodo = periodoTexto(planilla.periodo);\nreturn {\n  json: {\n    planillaId: planilla.id,\n    correo: cliente.email,\n    asunto: `${reenvio ? 'Planilla corregida para revisar' : 'Planilla para revisar'}: N.º ${planilla.numero} · ${obra.nombre} · ${periodo}`,\n    html: `<p>Estimado/a ${esc(nombreDe(cliente))}: le presentamos la planilla N.º ${planilla.numero} de ${periodo} de la obra ${esc(obra.nombre)}, con un neto de ${bs(planilla.neto)}.</p>`\n  },\n};\n"
      },
