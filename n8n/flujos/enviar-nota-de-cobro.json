    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];\nconst bs = (n) => 'Bs ' + Number(n).toFixed(2).replace('.', ',').replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst fecha = (iso) => String(iso).slice(0, 10).split('-').reverse().join('/');\nconst periodoTexto = (p) => { const [anio, mes] = String(p).split('-'); return `${MESES[Number(mes) - 1]} ${anio}`; };\nconst esc = (t) => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst nombreDe = (u) => [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;\n\nconst cobro = $('Leer cobro').item.json;\nconst planilla = $('Leer planilla').item.json;\nconst obra = $('Leer obra').item.json;\nconst cliente = $('Leer cliente').item.json;\nconst nombre = nombreDe(cliente);\nconst periodo = periodoTexto(planilla.periodo);\nreturn {\n  json: {\n    correo: cliente.email,\n    asunto: `Nota de cobro ${cobro.numero} · ${obra.nombre} · ${periodo}`,\n    html: `<p>Estimado/a ${esc(nombre)}: le enviamos la nota de cobro ${esc(cobro.numero)} por la planilla N.º ${planilla.numero} de ${periodo} de la obra ${esc(obra.nombre)}.</p>`\n      + `<p>Neto a cobrar: ${bs(cobro.montoNeto)}. Vence el ${fecha(cobro.venceEn)}.</p>`,\n    // Cuerpo de POST /cobros/{id}/nota-cobro: Finanzas comprueba que coincida con el cobro\n    nota: {\n      cliente: { nombre },\n      obra: { id: obra.id, nombre: obra.nombre },\n      planilla: {\n        id: planilla.id,\n        numero: planilla.numero,\n        periodo: planilla.periodo,\n        lineas: planilla.lineas.map((l) => ({\n          codigo: l.codigo, nombre: l.nombre, unidad: l.unidad,\n          cantidadPeriodo: l.cantidadPeriodo, precioUnitario: l.precioUnitario, monto: l.monto,\n        })),\n        subtotal: planilla.subtotal,\n        descuentoAnticipo: planilla.descuentoAnticipo,\n        retencion: planilla.retencion,\n        neto: planilla.neto,\n        anticipoPct: planilla.anticipoPct,\n        retencionPct: planilla.retencionPct,\n      },\n    },\n  },\n};\n"
      },
