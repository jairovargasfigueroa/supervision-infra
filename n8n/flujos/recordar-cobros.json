      "id": "5fa5c9cd-466a-57c5-85e3-0d95c7c85713",
      "name": "Pedir recordatorios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "cred201Keycloak1",
          "name": "Keycloak · cliente n8n"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Una sola lista: primero los por vencer, después los vencidos (Finanzas ya los ordena en cada grupo)\nconst { porVencer = [], vencidos = [] } = $input.first().json;\nreturn [\n  ...porVencer.map((cobro) => ({ json: { ...cobro, tipo: 'RECORDATORIO_POR_VENCER' } })),\n  ...vencidos.map((cobro) => ({ json: { ...cobro, tipo: 'RECORDATORIO_VENCIDO' } })),\n];\n"
      },
      "id": "d3ab44ca-2be4-5413-b2cd-323822f87c27",
      "name": "Unir cobros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "d1c9401a-310c-5d55-81df-56bf8861e255",
      "name": "Recorrer cobros",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        300
      ]
    },
