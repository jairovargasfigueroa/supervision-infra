    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "403675d4-b8f6-5f7e-b34e-7352473cfd32",
              "leftValue": "={{ Boolean($json.email) }}",
              "rightValue": "",
              "operator": {
