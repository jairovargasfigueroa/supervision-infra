        "url": "={{ $env.FINANZAS_URL }}/cobros/{{ $('Armar recordatorio').item.json.cobroId }}/envios",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo: $('Armar recordatorio').item.json.tipo, destinatario: $('Armar recordatorio').item.json.correo, ejecucionN8n: $execution.id }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "f4da7238-5d4f-5a54-84e8-4f0b2efce89f",
      "name": "Anotar recordatorio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        400
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "cred201Keycloak1",
          "name": "Keycloak · cliente n8n"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { ...$('Armar recordatorio').item.json, ok: true } };\n"
      },
      "id": "9f5b6b14-d4f9-5614-a38b-506e62e4d4d1",
      "name": "Recordado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Un cobro que no se pudo recordar no detiene a los demás: queda en la lista con su motivo y la ejecución termina\n// como fallida (nodo «Fallaron recordatorios»)\nconst cobro = $('Recorrer cobros').item.json;\nconst error = $json.error;\nconst motivo = error\n  ? (typeof error === 'string' ? error : error.message ?? JSON.stringify(error))\n  : 'El cliente no tiene correo registrado';\nreturn { json: { cobroId: cobro.id, numero: cobro.numero, montoNeto: cobro.montoNeto, venceEn: cobro.venceEn, tipo: cobro.tipo, ok: false, motivo } };\n"
      },
      "id": "a64807ac-8048-58ae-8615-16889b09f2b5",
      "name": "No recordado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];\nconst bs = (n) => 'Bs ' + Number(n).toFixed(2).replace('.', ',').replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst fecha = (iso) => String(iso).slice(0, 10).split('-').reverse().join('/');\nconst periodoTexto = (p) => { const [anio, mes] = String(p).split('-'); return `${MESES[Number(mes) - 1]} ${anio}`; };\nconst esc = (t) => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst nombreDe = (u) => [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;\n\nconst resultados = $input.all().map((item) => item.json);\nconst recordados = resultados.filter((r) => r.ok);\nconst errores = resultados.filter((r) => !r.ok).map((r) => `${r.numero}: ${r.motivo}`);\nconst hoy = $('Pedir recordatorios').first().json.hoy;\nconst TIPOS = { RECORDATORIO_POR_VENCER: 'Por vencer', RECORDATORIO_VENCIDO: 'Vencido' };\nconst celda = (t) => `<td style=\"border:1px solid #ccc;padding:4px 8px\">${esc(t)}</td>`;\nconst filas = recordados\n  .map((r) => `<tr>${celda(r.numero)}${celda(r.obra)}${celda(bs(r.montoNeto))}${celda(fecha(r.venceEn))}${celda(TIPOS[r.tipo])}</tr>`)\n  .join('');\nconst encabezado = ['Número', 'Obra', 'Monto', 'Vencimiento', 'Tipo'].map((t) => `<th style=\"border:1px solid #ccc;padding:4px 8px;text-align:left\">${t}</th>`).join('');\nreturn [{\n  json: {\n    fecha: fecha(hoy),\n    recordados: recordados.length,\n    errores,\n    html: `<p>Cobros recordados hoy:</p><table style=\"border-collapse:collapse\"><tr>${encabezado}</tr>${filas}</table>`,\n  },\n}];\n"
      },
      "id": "a72ca050-779b-515f-b2e3-04a3b61af3f6",
      "name": "Resumen",
      "type": "n8n-nodes-base.code",
