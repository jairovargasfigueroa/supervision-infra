      "id": "7f7172f8-cf79-5dd9-b67e-4e2176786593",
      "name": "¿Tiene correo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];\nconst bs = (n) => 'Bs ' + Number(n).toFixed(2).replace('.', ',').replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst fecha = (iso) => String(iso).slice(0, 10).split('-').reverse().join('/');\nconst periodoTexto = (p) => { const [anio, mes] = String(p).split('-'); return `${MESES[Number(mes) - 1]} ${anio}`; };\nconst esc = (t) => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst nombreDe = (u) => [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;\n\nconst cobro = $('Recorrer cobros').item.json;\nconst obra = $('Leer obra').item.json;\nconst cliente = $('Leer cliente').item.json;\nconst porVencer = cobro.tipo === 'RECORDATORIO_POR_VENCER';\nconst vence = fecha(cobro.venceEn);\nconst texto = `Su cobro ${cobro.numero} de ${bs(cobro.montoNeto)} por la obra ${obra.nombre} ${porVencer ? 'vence' : 'venció'} el ${vence}.`;\nreturn {\n  json: {\n    cobroId: cobro.id,\n    numero: cobro.numero,\n    obra: obra.nombre,\n    montoNeto: cobro.montoNeto,\n    venceEn: cobro.venceEn,\n    tipo: cobro.tipo,\n    correo: cliente.email,\n    asunto: porVencer ? `Recordatorio: su cobro ${cobro.numero} vence el ${vence}` : `Cobro vencido: ${cobro.numero} · ${obra.nombre}`,\n    html: `<p>${esc(texto)}</p><p>Si ya realizó el pago, no tome en cuenta este mensaje.</p>`,\n  },\n};\n"
      },
      "id": "1d48f48d-5de4-5a27-9280-0f9a0ca1393a",
      "name": "Armar recordatorio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        400
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.EMPRESA_NOMBRE }} <{{ $env.COBRANZA_REMITENTE }}>",
        "toEmail": "={{ $json.correo }}",
