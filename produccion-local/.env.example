# 601 · «Producción local»: variables de los tres grupos (azure, google y aws). Copia este archivo a .env (en esta
# carpeta) y completa los valores vacíos. Nunca subas el .env. Las contraseñas y secretos: solo letras, números, - y _
# (van dentro de URL de conexión) y distintos de los de desarrollo. README de infra, «Producción local».

# --- Direcciones públicas (en la 602, las de cada nube) -------------------------------------------------------------
# Cada grupo publica sus piezas en https://<pieza>.<grupo>.localhost:<puerto del grupo> con su Caddy:
# azure 8443, google 9443 y aws 10443 (fijos en los compose y los Caddyfile); RabbitMQ AMQPS en 5671.
KEYCLOAK_URL=https://keycloak.azure.localhost:8443
KEYCLOAK_REALM=supervision
GATEWAY_URL=https://gateway.azure.localhost:8443
OBRAS_URL=https://obras.azure.localhost:8443
FINANZAS_URL=https://finanzas.azure.localhost:8443
MATERIALES_URL=https://materiales.google.localhost:9443
IA_URL=https://ia.google.localhost:9443
SINCRONIZACION_URL=https://sincronizacion.aws.localhost:10443
S3_URL=https://s3.aws.localhost:10443
ERP_URL=https://erp.azure.localhost:8443
PORTAL_URL=https://portal.azure.localhost:8443
MF_OBRAS_URL=https://mf-obras.azure.localhost:8443
MF_MATERIALES_URL=https://mf-materiales.azure.localhost:8443
MF_SUPERVISION_URL=https://mf-supervision.azure.localhost:8443
N8N_URL=https://n8n.azure.localhost:8443
MAILPIT_URL=https://mailpit.azure.localhost:8443
RABBITMQ_PANEL_URL=https://rabbitmq.azure.localhost:8443
# RabbitMQ por TLS (AMQPS) para los servicios de todos los grupos
RABBITMQ_HOST=rabbitmq.azure.localhost
RABBITMQ_PUERTO_TLS=5671
# CA local (la genera certificados.ps1/.sh; relativa a esta carpeta). Los scripts de Node de la máquina la usan;
# los contenedores la reciben montada en /certificados. En la nube se deja vacía (certificados públicos).
CA_LOCAL=certificados/ca.crt

# --- Imágenes ----------------------------------------------------------------------------------------------------
# Por defecto se construyen desde las carpetas de los proyectos con la etiqueta «local»; con levantar -DesdeGhcr
# se descargan las publicadas por GitHub Actions con la etiqueta «main».
IMAGENES=ghcr.io/jairovargasfigueroa
IMAGEN_ETIQUETA=local
# Carpetas de los proyectos (relativas a esta carpeta; por defecto, las hermanas de infra)
OBRAS_DIR=../../services/obras
FINANZAS_DIR=../../services/finanzas
MATERIALES_DIR=../../services/materiales
IA_DIR=../../services/ia
SINCRONIZACION_DIR=../../services/sincronizacion
GATEWAY_DIR=../../gateway
ERP_SHELL_DIR=../../frontend/erp-shell
MF_OBRAS_DIR=../../frontend/mf-obras
MF_MATERIALES_DIR=../../frontend/mf-materiales
MF_SUPERVISION_DIR=../../frontend/mf-supervision
PORTAL_DIR=../../frontend/portal

# --- Keycloak (grupo azure) ----------------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USUARIO=admin
KEYCLOAK_ADMIN_CLAVE=
# Contraseña de los usuarios de prueba al importar el realm: distinta de Prueba123! (que está en el repositorio)
USUARIOS_PRUEBA_CLAVE=
# Secretos de los clientes confidenciales (el realm los toma al importarse; cada servicio recibe el suyo)
KEYCLOAK_GATEWAY_CLIENT_SECRET=
IA_REPORTES_CLIENT_SECRET=
IA_AGENTES_CLIENT_SECRET=
N8N_KEYCLOAK_SECRETO=

# --- PostgreSQL ------------------------------------------------------------------------------------------------
# Grupo azure: superusuario y un usuario por base (obras_db, finanzas_db y keycloak_db)
POSTGRES_CLAVE=
POSTGRES_OBRAS_CLAVE=
POSTGRES_FINANZAS_CLAVE=
POSTGRES_KEYCLOAK_CLAVE=
# Grupo google: base de reportes (usuario ia y rol de solo lectura ia_reportes_lector)
POSTGRES_REPORTES_CLAVE=
POSTGRES_IA_CLAVE=
POSTGRES_IA_LECTOR_CLAVE=

# --- RabbitMQ (grupo azure) ----------------------------------------------------------------------------------------
RABBITMQ_ADMIN_USUARIO=admin
RABBITMQ_ADMIN_CLAVE=
RABBITMQ_OBRAS_CLAVE=
RABBITMQ_MATERIALES_CLAVE=
RABBITMQ_FINANZAS_CLAVE=
RABBITMQ_IA_CLAVE=
RABBITMQ_N8N_CLAVE=

# --- Finanzas -----------------------------------------------------------------------------------------------------
# APP_KEY de Laravel: base64:<32 bytes al azar>, por ejemplo la salida de
# node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
FINANZAS_APP_KEY=
EMPRESA_NOMBRE=Constructora Andina

# --- n8n y Mailpit (grupo azure; README de infra, «Cobranza automática») ---------------------------------------------
N8N_ENCRYPTION_KEY=
N8N_PROPIETARIO_CORREO=
N8N_PROPIETARIO_CLAVE_HASH=
COBRANZA_REMITENTE=cobranzas@constructora-andina.test
COBRANZA_CORREO=cobranzas@constructora-andina.test

# --- Servicio de IA (grupo google) --------------------------------------------------------------------------------
# ollama (con el perfil ollama del grupo google, que reusa el modelo del volumen de desarrollo) o anthropic
IA_LLM_PROVEEDOR=ollama
IA_LLM_MODELO=
# Por defecto, el servicio ollama del grupo google. Sin él: otro Ollama alcanzable desde el contenedor
IA_OLLAMA_URL=http://ollama:11434
IA_ANTHROPIC_API_KEY=

# --- S3 compatible (MinIO, grupo aws) -------------------------------------------------------------------------------
# Usuario y contraseña del MinIO (también las claves de S3 de Obras y de la semilla; mínimo 8 caracteres)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=supervision-demo

# --- Datos de demostración (semilla -Entorno produccion-local/.env) -------------------------------------------------
# Permite cargar los datos de prueba aquí (nunca vaciarlos). Cada servicio carga con su imagen en su grupo:
SEMILLA_DEMO=si
SEMILLA_COMPOSE_OBRAS=compose.azure.yml
SEMILLA_COMPOSE_FINANZAS=compose.azure.yml
SEMILLA_COMPOSE_MATERIALES=compose.google.yml
SEMILLA_COMPOSE_S3=compose.aws.yml
