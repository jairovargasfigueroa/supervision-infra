# Contraseñas de desarrollo. Copia este archivo a .env y completa los valores vacíos.
# Los mismos valores van en el .env de cada proyecto (ver docs/entorno-local.md de supervision-docs).

# Keycloak: administrador del panel (http://localhost:8080/admin)
KEYCLOAK_ADMIN_USUARIO=admin
KEYCLOAK_ADMIN_CLAVE=
# Secreto del cliente ia-reportes (401, carga inicial del servicio de IA). Valor de ejemplo: cámbialo en tu .env
# (solo letras, números, - y _) y cópialo a IA_REPORTES_CLIENT_SECRET del .env de services/ia
IA_REPORTES_CLIENT_SECRET=ia-reportes-secreto-de-ejemplo
# Secreto del cliente ia-agentes (501, cliente MCP de los agentes del servicio de IA). Valor de ejemplo: cámbialo en
# tu .env (solo letras, números, - y _) y cópialo a IA_AGENTES_CLIENT_SECRET del .env de services/ia
IA_AGENTES_CLIENT_SECRET=ia-agentes-secreto-de-ejemplo
# Secreto del cliente n8n (201, automatización de cobranza): ponle tu valor (solo letras, números, - y _). El realm lo
# toma al importarse y n8n lo recibe en su credencial OAuth2 (CREDENTIALS_OVERWRITE_DATA); si cambia, recrea Keycloak.
# Vacía: Keycloak le pone al cliente n8n un secreto al azar (queda sin uso) y el perfil automatizacion no arranca
N8N_KEYCLOAK_SECRETO=

# RabbitMQ: administrador del panel (http://localhost:15672) y un usuario por servicio
RABBITMQ_ADMIN_USUARIO=admin
RABBITMQ_ADMIN_CLAVE=
RABBITMQ_OBRAS_CLAVE=
RABBITMQ_MATERIALES_CLAVE=
RABBITMQ_FINANZAS_CLAVE=
RABBITMQ_IA_CLAVE=
# Usuario n8n (201 y 010, perfil automatizacion): solo lee sus colas n8n.*. Vacía: no se crea
# (y el servicio n8n no arranca)
RABBITMQ_N8N_CLAVE=

# PostgreSQL y MongoDB en contenedor (solo con el perfil "bases")
POSTGRES_USUARIO=postgres
POSTGRES_CLAVE=
# Usuario propio del servicio de IA, dueño de reportes_db (401); se copia a IA_REPORTES_DB_URL del .env de IA
POSTGRES_IA_CLAVE=
# Rol de solo lectura ia_reportes_lector de reportes_db (503, constructor de reportes); se copia a
# IA_REPORTES_DB_URL_LECTURA del .env de IA
POSTGRES_IA_LECTOR_CLAVE=

# Cobranza automática (201, perfil automatizacion: n8n y Mailpit). Si falta alguna de las obligatorias, solo el
# servicio n8n se detiene y dice cuál; los demás perfiles no las necesitan.
# Obligatorias: clave de cifrado de las credenciales de n8n (una vez; si cambia, n8n no lee lo que ya guardó) y la
# cuenta de propietario del panel (http://localhost:5678): correo y hash bcrypt de la contraseña, entre comillas
# simples (README, «Cobranza automática: n8n y Mailpit»). También N8N_KEYCLOAK_SECRETO y RABBITMQ_N8N_CLAVE (arriba).
N8N_ENCRYPTION_KEY=
N8N_PROPIETARIO_CORREO=
N8N_PROPIETARIO_CLAVE_HASH=
# Opcionales (estos son los valores por defecto)
# N8N_PROPIETARIO_NOMBRE=Administración
# N8N_PROPIETARIO_APELLIDO=Cobranzas
# N8N_FINANZAS_URL=http://host.docker.internal:8083
# N8N_OBRAS_URL=http://host.docker.internal:8081
# Datos de los correos de cobranza (el nombre de la empresa es el mismo EMPRESA_NOMBRE del .env de Finanzas)
EMPRESA_NOMBRE=Constructora Andina
COBRANZA_REMITENTE=cobranzas@constructora-andina.test
COBRANZA_CORREO=cobranzas@constructora-andina.test

# Carga de datos de prueba (011): solo se permite donde esta variable vale "si"
SEMILLA_PERMITIDA=si
# Carpetas de los servicios que cargan su parte (relativas a infra/; por defecto, las carpetas hermanas)
OBRAS_DIR=../services/obras
FINANZAS_DIR=../services/finanzas
MATERIALES_DIR=../services/materiales
# Carpeta del servicio de IA para construir su imagen (perfil ia, 401)
IA_DIR=../services/ia
# Modelo de lenguaje del servicio de IA en contenedor (503 y 502): ollama (por defecto, servicio ollama del perfil
# ollama) o anthropic. IA_LLM_MODELO vacío: qwen3:8b con ollama y claude-sonnet-5-5 con anthropic.
IA_LLM_PROVEEDOR=ollama
IA_LLM_MODELO=
# Opcional: otro Ollama (por ejemplo instalado en Windows: http://host.docker.internal:11434). Por defecto http://ollama:11434
# IA_OLLAMA_URL=http://ollama:11434
# Clave de la API de Anthropic: solo en tu .env, nunca en el repositorio. Con anthropic y sin clave, IA no arranca.
IA_ANTHROPIC_API_KEY=
# Opcionales: dónde comprueba la semilla que responden las piezas (estos son los valores por defecto)
# SEMILLA_POSTGRES=localhost:5433
# SEMILLA_MONGO=localhost:27017
# KEYCLOAK_URL=http://localhost:8080
# RABBITMQ_PANEL_URL=http://localhost:15672

# Bucket S3 de desarrollo y claves del usuario IAM supervision-dev (docs/entorno-local.md, «Archivos en desarrollo»).
# Las usa el servicio s3-cli (perfil herramientas) para subir y borrar las fotos de prueba.
# El bucket debe empezar con supervision-dev-; si falta el bucket o las claves, la semilla salta las fotos con un aviso.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
