# 602 · Nube: variables de las tres nubes (azure, google y aws). «node nube/nube.mjs secretos» copia este archivo a
# nube/.env y llena con valores al azar los secretos vacíos; lo demás (correos, Gmail, Firebase, Anthropic) se completa
# a mano. Nunca subas nube/.env y guarda una copia: las bases se crean con esas contraseñas. «desplegar» copia a cada
# máquina solo las variables que usa su compose. Contraseñas: solo letras, números, - y _ (van dentro de URL).

# --- Dominio y direcciones públicas --------------------------------------------------------------------------------
# Todas las piezas en https://<pieza>.<DOMINIO> (registros A en Namecheap: «node nube/nube.mjs dns»)
DOMINIO=supervision.workflow-tramites.site
KEYCLOAK_URL=https://keycloak.supervision.workflow-tramites.site
KEYCLOAK_REALM=supervision
GATEWAY_URL=https://gateway.supervision.workflow-tramites.site
OBRAS_URL=https://obras.supervision.workflow-tramites.site
FINANZAS_URL=https://finanzas.supervision.workflow-tramites.site
MATERIALES_URL=https://materiales.supervision.workflow-tramites.site
IA_URL=https://ia.supervision.workflow-tramites.site
SINCRONIZACION_URL=https://sincronizacion.supervision.workflow-tramites.site
ERP_URL=https://erp.supervision.workflow-tramites.site
PORTAL_URL=https://portal.supervision.workflow-tramites.site
MF_OBRAS_URL=https://mf-obras.supervision.workflow-tramites.site
MF_MATERIALES_URL=https://mf-materiales.supervision.workflow-tramites.site
MF_SUPERVISION_URL=https://mf-supervision.supervision.workflow-tramites.site
N8N_URL=https://n8n.supervision.workflow-tramites.site
MAILPIT_URL=https://mailpit.supervision.workflow-tramites.site
RABBITMQ_PANEL_URL=https://rabbitmq.supervision.workflow-tramites.site
# RabbitMQ por TLS (AMQPS) para los servicios de las tres nubes
RABBITMQ_HOST=rabbitmq.supervision.workflow-tramites.site
RABBITMQ_PUERTO_TLS=5671
# Sin CA local: los certificados son de Let's Encrypt
CA_LOCAL=
# Correo para Let's Encrypt (avisos de vencimiento de los certificados)
ACME_CORREO=

# --- Nubes y máquinas ----------------------------------------------------------------------------------------------
# Correo de los avisos de presupuesto (Azure y AWS)
NUBE_ALERTAS_CORREO=
AZURE_REGION=brazilsouth
AZURE_GRUPO=rg-supervision
AZURE_TAMANO=Standard_B2s
# La organización de la cuenta de AWS solo permite us-east-2 (Ohio): las demás regiones están bloqueadas por su SCP
AWS_REGION=us-east-2
AWS_TIPO=t3.micro
GOOGLE_PROYECTO=supervision-obras
GOOGLE_REGION=southamerica-east1
GOOGLE_ZONA=southamerica-east1-a
GOOGLE_TIPO=e2-medium
# Clave SSH de las máquinas (la crea «secretos» si no existe; ~ = la carpeta del usuario)
SSH_CLAVE=~/.ssh/supervision_nube
# Presupuestos mensuales en dólares (avisos al 50, 80 y 100 %)
AZURE_PRESUPUESTO=50
AWS_PRESUPUESTO=20

# --- Imágenes (GHCR) -----------------------------------------------------------------------------------------------
# main = la del último release; para volver atrás un servicio: <SERVICIO>_ETIQUETA=sha-<7> (OBRAS_ETIQUETA, …)
IMAGENES=ghcr.io/jairovargasfigueroa
IMAGEN_ETIQUETA=main

# --- Keycloak (azure) ----------------------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USUARIO=admin
KEYCLOAK_ADMIN_CLAVE=
# Contraseña de los usuarios de prueba (fácil de escribir en el celular; distinta de Prueba123!). Keycloak la toma solo
# la primera vez que importa el realm; después se cambia en su consola. «secretos» pone una de dos palabras y 4 dígitos.
USUARIOS_PRUEBA_CLAVE=
# Buzón real de cliente1 (recibe la nota de cobro en la demostración); vacío = cliente1@correo.test
CLIENTE1_CORREO=
KEYCLOAK_GATEWAY_CLIENT_SECRET=
IA_REPORTES_CLIENT_SECRET=
IA_AGENTES_CLIENT_SECRET=
N8N_KEYCLOAK_SECRETO=

# --- PostgreSQL ------------------------------------------------------------------------------------------------
# azure: superusuario y un usuario por base (obras_db, finanzas_db y keycloak_db)
POSTGRES_CLAVE=
POSTGRES_OBRAS_CLAVE=
POSTGRES_FINANZAS_CLAVE=
POSTGRES_KEYCLOAK_CLAVE=
# google: base de reportes (usuario ia y rol de solo lectura ia_reportes_lector)
POSTGRES_REPORTES_CLAVE=
POSTGRES_IA_CLAVE=
POSTGRES_IA_LECTOR_CLAVE=

# --- RabbitMQ (azure) ----------------------------------------------------------------------------------------------
RABBITMQ_ADMIN_USUARIO=admin
RABBITMQ_ADMIN_CLAVE=
RABBITMQ_OBRAS_CLAVE=
RABBITMQ_MATERIALES_CLAVE=
RABBITMQ_FINANZAS_CLAVE=
RABBITMQ_IA_CLAVE=
RABBITMQ_N8N_CLAVE=

# --- Finanzas ------------------------------------------------------------------------------------------------------
FINANZAS_APP_KEY=
EMPRESA_NOMBRE=Constructora Andina

# --- n8n, correo y Mailpit (azure) -------------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
# Cuenta de n8n: correo, contraseña (para entrar al panel; no se copia a la máquina) y su hash bcrypt (lo genera
# «secretos» con la imagen de n8n, entre comillas simples)
N8N_PROPIETARIO_CORREO=n8n@constructora-andina.test
N8N_PROPIETARIO_CLAVE=
N8N_PROPIETARIO_CLAVE_HASH=
# Gmail de la plataforma (verificación en dos pasos y una contraseña de aplicación). Vacías = Mailpit
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=
# Remitente de los correos y copia oculta: el Gmail de la plataforma (vacías: cobranzas@constructora-andina.test, con Mailpit)
COBRANZA_REMITENTE=
COBRANZA_CORREO=
# Interfaz de Mailpit (respaldo) con autenticación básica en Caddy
MAILPIT_USUARIO=admin
MAILPIT_CLAVE=
MAILPIT_CLAVE_HASH=
# Firebase (010): project_id, client_email y private_key de la cuenta de servicio (la clave en una línea con sus \n,
# entre comillas simples). Vacías: sin push
FIREBASE_PROYECTO_ID=
FIREBASE_CUENTA_CORREO=
FIREBASE_CLAVE_PRIVADA=

# --- Servicio de IA (google) ---------------------------------------------------------------------------------------
# anthropic (con límite de gasto en su consola) u ollama (perfil ollama y una máquina de 16 GB)
IA_LLM_PROVEEDOR=anthropic
IA_LLM_MODELO=
IA_OLLAMA_URL=http://ollama:11434
IA_ANTHROPIC_API_KEY=
# mongo:8.0, o mongo:7.0 si el kernel de vm-ia es 6.19 o más («crear google» lo revisa)
MONGO_IMAGEN=mongo:8.0

# --- S3 (aws) ------------------------------------------------------------------------------------------------------
# Nombre único en todo S3: «secretos» le agrega un sufijo al azar. Las claves de obras-s3 las escribe «crear aws --datos»
S3_BUCKET=
OBRAS_S3_ACCESS_KEY=
OBRAS_S3_SECRET_KEY=

# --- Datos de demostración (semilla.ps1 -Entorno nube/.env, con las tres nubes; rutas relativas a esta carpeta) ----
SEMILLA_DEMO=si
SEMILLA_COMPOSE_OBRAS=compose.azure.yml
SEMILLA_COMPOSE_FINANZAS=compose.azure.yml
SEMILLA_COMPOSE_MATERIALES=compose.google.yml
SEMILLA_COMPOSE_S3=compose.aws.yml
# Cada servicio carga con su imagen dentro de su máquina (contextos de Docker por SSH: «nube.mjs contextos»)
SEMILLA_CONTEXTO_OBRAS=supervision-azure
SEMILLA_CONTEXTO_FINANZAS=supervision-azure
SEMILLA_CONTEXTO_MATERIALES=supervision-google
